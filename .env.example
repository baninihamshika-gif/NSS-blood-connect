# Supabase project URL (Project Settings > API)
VITE_SUPABASE_URL=

# Supabase anon/publishable key (safe for frontend use — never the service_role key)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: local-dev-only demo accounts. When set, "Demo Login" buttons appear
# on the login page in `npm run dev` (never in a production build). Create the
# accounts in Supabase first (pre-confirmed, with profiles/donor_profiles rows)
# and put their real credentials here — never commit real values.
VITE_DEMO_DONOR_EMAIL=
VITE_DEMO_DONOR_PASSWORD=
VITE_DEMO_REQUESTER_EMAIL=
VITE_DEMO_REQUESTER_PASSWORD=
